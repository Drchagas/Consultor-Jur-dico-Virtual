# JARBAS Jurídico — configuração de servidor.
#
#   cp deploy/env.servidor.example .env
#   chmod 600 .env
#
# NUNCA versione este arquivo preenchido. O .gitignore já cobre .env e
# .env.local, mas a responsabilidade é de quem edita.

# ------------------------------------------------------------------ básico
JARBAS_ENV=production

# Obrigatória, mínimo 32 caracteres. Gere com:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# Trocar esta chave derruba todas as sessões abertas.
JARBAS_SECRET_KEY=

# Domínios pelos quais o JARBAS responde. Sem esta lista o servidor aceita
# qualquer cabeçalho Host. 'testserver' NUNCA entra aqui em produção.
JARBAS_ALLOWED_HOSTS=jarbas.seudominio.com.br

# URL pública completa. O Mercado Pago e os links de recuperação usam isto.
JARBAS_PUBLIC_URL=https://jarbas.seudominio.com.br
JARBAS_DOMINIO=jarbas.seudominio.com.br

# --------------------------------------------------------------- segurança
# 1 = cookie de sessão só trafega em HTTPS. Com autos reais, mantenha 1.
JARBAS_HTTPS_ONLY=1

# 1 = todo membro precisa de verificação em duas etapas. Com autos reais,
# mantenha 1: uma senha vazada abre os processos de todos os clientes.
JARBAS_2FA_OBRIGATORIO=1

# 0 = ninguém cria workspace sozinho pela internet.
JARBAS_PUBLIC_SIGNUP=0

# Quantos proxies reversos existem na frente do JARBAS. Com o Caddy do
# docker-compose, é 1. Em 0 o X-Forwarded-For é ignorado — correto quando o
# JARBAS recebe conexão direta, porque o cabeçalho pode ser forjado.
JARBAS_TRUSTED_PROXY_HOPS=1

# Sessão expira em 8 horas (28800s). Reduza para escritório com computador
# compartilhado ou acesso remoto.
JARBAS_SESSION_MAX_AGE=28800

# --------------------------------------------------------------- banco
POSTGRES_DB=jarbas
POSTGRES_USER=jarbas
# Gere com: python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=

# ------------------------------------------------------- primeiro acesso
JARBAS_ADMIN_EMAIL=schagasadvocacia@gmail.com
# Usada UMA vez, para criar o primeiro usuário. Depois que o hash está no
# banco, apague esta linha e reinicie: manter senha em claro no arquivo é
# risco sem contrapartida.
JARBAS_BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------- operação
JARBAS_UF=RS
JARBAS_MAX_UPLOAD_MB=200
JARBAS_RETENCAO_LIXEIRA_DIAS=30
JARBAS_WORKERS=2
JARBAS_BIND=127.0.0.1
JARBAS_PORT_HOST=8765
JARBAS_BACKUP_MANTER=14
JARBAS_BACKUP_HOST_DIR=./backups

# ------------------------------------------------------------------- IA
# Chave em console.anthropic.com, começa com sk-ant-. OPCIONAL: sem ela o
# JARBAS opera como gestão de processos, clientes, prazos e financeiro.
# Cole a chave AQUI, no servidor — nunca no repositório, em e-mail ou WhatsApp.
ANTHROPIC_API_KEY=

# Teto de gasto mensal em dólar, medido por token real. 0 = sem teto.
# NÃO opere com clientes reais sem teto.
JARBAS_AI_TETO_USD_MES=50

JARBAS_AI_MODEL_LEGAL=claude-opus-5
JARBAS_AI_MODEL_INTAKE=claude-sonnet-5
JARBAS_AI_MODEL_ROUTINE=claude-haiku-4-5-20251001

# ------------------------------------------------------------- cobrança
# Token com prefixo TEST- = sandbox, não movimenta dinheiro real.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# O segredo do webhook é um valor DIFERENTE do access token.
# MERCADOPAGO_WEBHOOK_SECRET=

# ------------------------------------------------------- consulta de autos
# API Pública do DataJud (CNJ), gratuita.
# DATAJUD_API_KEY=
