JARBAS_ENV=production
JARBAS_SECRET_KEY=GERAR_SEGREDO_FORTE
JARBAS_ADMIN_EMAIL=admin@seuescritorio.com.br
JARBAS_ADMIN_PASSWORD=TROCAR_SENHA
JARBAS_ALLOWED_HOSTS=localhost,127.0.0.1
JARBAS_HTTPS_ONLY=0
JARBAS_PUBLIC_SIGNUP=0
JARBAS_MAX_UPLOAD_MB=200
# DATABASE_URL=postgresql://usuario:senha@db:5432/jarbas

# 1 = perguntas/análises com IA conferem o PDF original quando disponível
JARBAS_AI_PDF_ALWAYS=1


# ---------------------------------------------------------------------------
# O SDK anthropic e OPCIONAL (requirements-ia.txt).
# Com UMA so chave o sistema funciona, mas a critica adversarial
# fica DESLIGADA (um modelo revisando o proprio texto tende a aprova-lo).
# Com DUAS ou mais, a revisao independente entra automaticamente.
# ANTHROPIC_API_KEY=

# Teto de gasto mensal em dolar, medido por token real. 0 = sem teto.
# NAO opere com clientes reais sem teto.
JARBAS_AI_TETO_USD_MES=50

# Divisao de papeis. Formato: provedor:modelo
# Padroes de 09/2026 — reveja ao trocar de geracao de modelo.
JARBAS_PAPEL_REDACAO=anthropic:claude-opus-5

# ---------------------------------------------------------------------------
# COBRANCA — MERCADO PAGO (8.7)
# ---------------------------------------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel
# Token com prefixo TEST- = sandbox, nao movimenta dinheiro real.
# NUNCA versione este arquivo preenchido. O .gitignore ja cobre .env.local.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# ATENCAO: o segredo do webhook e um valor DIFERENTE do access token.
# Gerado na configuracao de Webhooks da aplicacao, em Suas integracoes.
# MERCADOPAGO_WEBHOOK_SECRET=

# URL https publica do JARBAS. O Mercado Pago precisa alcancar
# {JARBAS_PUBLIC_URL}/webhooks/mercadopago pela internet.
# Lembre de incluir esse dominio em JARBAS_ALLOWED_HOSTS.
# JARBAS_PUBLIC_URL=https://app.seudominio.com.br

# ---------------------------------------------------------------------------
# SEGURANCA, RETENCAO E BANCO (8.8)
# ---------------------------------------------------------------------------
# Exigir 2FA de todos os membros (1 = sim). Recomendado antes de operar com
# autos de clientes em maquina compartilhada ou acesso remoto.
JARBAS_2FA_OBRIGATORIO=0

# Dias entre excluir um documento e o expurgo definitivo. 0 = expurgo imediato.
JARBAS_RETENCAO_LIXEIRA_DIAS=30

# Pool de conexoes do PostgreSQL (ignorado no SQLite).
JARBAS_DB_POOL_MIN=2
JARBAS_DB_POOL_MAX=20
JARBAS_DB_POOL_TIMEOUT=15

# ---------------------------------------------------------------------------
# PRAZOS E MOVIMENTACOES (8.9)
# ---------------------------------------------------------------------------
# UF para feriados estaduais no calculo de prazo.
JARBAS_UF=RS

# API Publica do DataJud (CNJ) — consulta de movimentacoes processuais.
# Gratuita. A chave publica e divulgada pelo proprio CNJ em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/ e pode ser trocada
# por eles a qualquer momento.
# DATAJUD_API_KEY=

# ---------------------------------------------------------------------------
# CLAUDE — PROVEDOR UNICO DE IA (9.0)
# ---------------------------------------------------------------------------
# Chave em console.anthropic.com. NUNCA versione este arquivo preenchido.
# ANTHROPIC_API_KEY=

# Modelos por perfil de uso.
JARBAS_AI_MODEL_LEGAL=claude-opus-5
JARBAS_AI_MODEL_INTAKE=claude-sonnet-5
JARBAS_AI_MODEL_ROUTINE=claude-haiku-4-5-20251001

# Teto de gasto mensal em dolar, medido por token real. 0 = sem teto.
# NAO opere com clientes reais sem teto.
JARBAS_AI_TETO_USD_MES=50

# Divisao de papeis do Conselho. Formato: anthropic:modelo
JARBAS_PAPEL_EXTRACAO=anthropic:claude-sonnet-5
JARBAS_PAPEL_ESTRATEGIA=anthropic:claude-opus-5
JARBAS_PAPEL_REDACAO=anthropic:claude-opus-5
JARBAS_PAPEL_CRITICA=anthropic:claude-sonnet-5
JARBAS_PAPEL_ROTINA=anthropic:claude-haiku-4-5-20251001

JARBAS_AI_TIMEOUT=240
JARBAS_AI_MAX_PDF_FILES=10
JARBAS_AI_MAX_PDF_MB=200
